{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a2b5a7e1-8c3d-4f5e-9a1b-2c3d4e5f6a7b",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 86400000 },
                { "durationMs": 604800000 },
                { "durationMs": 2592000000 }
              ]
            },
            "value": { "durationMs": 604800000 },
            "label": "Time Range"
          },
          {
            "id": "b3c6d8f2-9e4a-5b6c-0d2e-3f4a5b6c7d8e",
            "version": "KqlParameterItem/1.0",
            "name": "ClientTenant",
            "type": 2,
            "isRequired": false,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "Beacon_Alerts_CL\n| where TimeGenerated > ago(30d)\n| where isnotempty(ClientTenantName)\n| distinct ClientTenantName\n| order by ClientTenantName asc",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "typeSettings": {
              "additionalResourceOptions": ["value::all"],
              "selectAllValue": "*"
            },
            "value": ["value::all"],
            "label": "Client Tenant"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| count",
              "size": 4,
              "title": "Total Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": { "columnMatch": "Count", "formatter": 12, "formatOptions": { "palette": "auto" } },
                "showBorder": true
              }
            },
            "customWidth": "25",
            "name": "tile-total-alerts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| where Severity == 'Critical'\n| count",
              "size": 4,
              "title": "Critical Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": { "columnMatch": "Count", "formatter": 12, "formatOptions": { "palette": "redBright" } },
                "showBorder": true
              }
            },
            "customWidth": "25",
            "name": "tile-critical-alerts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize count() by ClientTenantName\n| count",
              "size": 4,
              "title": "Clients Affected",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": { "columnMatch": "Count", "formatter": 12, "formatOptions": { "palette": "blue" } },
                "showBorder": true
              }
            },
            "customWidth": "25",
            "name": "tile-clients-affected"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| where isnotempty(Target)\n| summarize count() by Target\n| count",
              "size": 4,
              "title": "Unique Targets",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": { "columnMatch": "Count", "formatter": 12, "formatOptions": { "palette": "purple" } },
                "showBorder": true
              }
            },
            "customWidth": "25",
            "name": "tile-unique-targets"
          }
        ]
      },
      "name": "group-summary-tiles"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize AlertCount = count() by bin(TimeGenerated, 1h)\n| order by TimeGenerated asc",
              "size": 1,
              "title": "Alerts Over Time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "areachart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": ["AlertCount"],
                "seriesLabelSettings": [{ "seriesName": "AlertCount", "label": "Alerts", "color": "blue" }]
              }
            },
            "customWidth": "50",
            "name": "chart-alerts-over-time"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize Count = count() by Severity\n| order by Count desc",
              "size": 1,
              "title": "Severity Breakdown",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  { "seriesName": "Critical", "color": "redBright" },
                  { "seriesName": "High", "color": "orange" },
                  { "seriesName": "Medium", "color": "yellow" },
                  { "seriesName": "Low", "color": "blue" }
                ]
              }
            },
            "customWidth": "50",
            "name": "chart-severity-breakdown"
          }
        ]
      },
      "name": "group-charts-row1"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize AlertCount = count() by ClientTenantName\n| top 10 by AlertCount desc",
              "size": 0,
              "title": "Top 10 Clients by Alert Volume",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart",
              "chartSettings": {
                "xAxis": "ClientTenantName",
                "yAxis": ["AlertCount"],
                "seriesLabelSettings": [{ "seriesName": "AlertCount", "label": "Alerts", "color": "turquoise" }]
              }
            },
            "customWidth": "50",
            "name": "chart-top-clients"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize AlertCount = count() by RuleName\n| top 10 by AlertCount desc",
              "size": 0,
              "title": "Top 10 Rules Triggered",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart",
              "chartSettings": {
                "xAxis": "RuleName",
                "yAxis": ["AlertCount"],
                "seriesLabelSettings": [{ "seriesName": "AlertCount", "label": "Alerts", "color": "green" }]
              }
            },
            "customWidth": "50",
            "name": "chart-top-rules"
          }
        ]
      },
      "name": "group-charts-row2"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nBeacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| project TimeGenerated, ClientTenantName, Actor, Target, RuleName, Severity, SourceType, RawEventSummary\n| order by TimeGenerated desc\n| take 100",
              "size": 0,
              "title": "Recent Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "TimeGenerated",
                    "formatter": 6,
                    "formatOptions": { "customColumnWidthSetting": "180px" }
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        { "operator": "==", "thresholdValue": "Critical", "representation": "redBright", "text": "{0}{1}" },
                        { "operator": "==", "thresholdValue": "High", "representation": "orange", "text": "{0}{1}" },
                        { "operator": "==", "thresholdValue": "Medium", "representation": "yellow", "text": "{0}{1}" },
                        { "operator": "==", "thresholdValue": "Low", "representation": "blue", "text": "{0}{1}" },
                        { "operator": "Default", "representation": "gray", "text": "{0}{1}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "RawEventSummary",
                    "formatter": 0,
                    "formatOptions": { "customColumnWidthSetting": "400px" }
                  }
                ],
                "sortBy": [{ "itemKey": "TimeGenerated", "sortOrder": 2 }]
              }
            },
            "name": "table-recent-alerts"
          }
        ]
      },
      "name": "group-recent-alerts"
    }
  ],
  "fallbackResourceIds": []
}
