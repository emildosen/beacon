                      "leftContent": {
                        "columnMatch": "AlertCount",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "maximumSignificantDigits": 3,
                            "maximumFractionDigits": 2
                          }
                        }
                      }
                    },
                    "chartSettings": {
                      "xAxis": "ClientTenantName",
                      "yAxis": [
                        "AlertCount"
                      ],
                      "showMetrics": false,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "AlertCount",
                          "label": "Alerts",
                          "color": "turquoise"
