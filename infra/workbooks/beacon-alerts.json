      "name": "group-summary-tiles"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nlet duration = {TimeRange:seconds};\nlet stepSize = case(duration <= 86400, 1h, duration <= 604800, 6h, 24h);\nlet start = bin(ago(duration * 1s), stepSize);\nlet end = bin(now(), stepSize);\nlet alerts = Beacon_Alerts_CL\n| where TimeGenerated between (start .. end)\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize AlertCount = count() by bin(TimeGenerated, stepSize);\nrange ts from start to end step stepSize\n| extend TimeGenerated = bin(todatetime(ts), stepSize)\n| join kind=leftouter alerts on TimeGenerated\n| extend AlertCount = coalesce(AlertCount, 0)\n| project TimeGenerated, AlertCount\n| order by TimeGenerated asc",
              "size": 1,
              "title": "Alerts Over Time",
              "color": "grayBlue",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "AlertCount"
                ],
                "showMetrics": false,
                "seriesLabelSettings": [
                  {
                    "seriesName": "AlertCount",
                    "label": "Alerts"
                  }
                ]
              }
            },
            "customWidth": "65",
            "name": "chart-alerts-over-time"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let selectedClients = dynamic([{ClientTenant}]);\nlet severities = datatable(Severity: string, SortOrder: int) ['Critical', 0, 'High', 1, 'Medium', 2, 'Low', 3];\nlet alerts = Beacon_Alerts_CL\n| where TimeGenerated {TimeRange}\n| where '*' in (selectedClients) or ClientTenantName in (selectedClients)\n| summarize Count = count() by Severity;\nseverities\n| join kind=leftouter alerts on Severity\n| extend Count = coalesce(Count, 0)\n| order by SortOrder asc\n| project Severity, Count",
              "size": 1,
              "title": "Severity Breakdown",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Severity",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "none"
                  }
                },
                "showBorder": true,
                "size": "auto",
                "styleSettings": {
                  "backgroundColor": "colorGray300"
                }
              },
              "chartSettings": {
                "group": "Severity",
                "createOtherGroup": 0,
                "showMetrics": true,
                "seriesLabelSettings": [
                  {
                    "seriesName": "Critical",
                    "color": "redDark"
                  },
                  {
                    "seriesName": "High",
                    "color": "orangeDark"
                  },
                  {
                    "seriesName": "Medium",
                    "color": "yellowDark"
                  },
                  {
                    "seriesName": "Low",
                    "color": "blueDark"
                  }
                ]
              }
            },
            "customWidth": "35",
            "name": "chart-severity-breakdown"
          }
        ]
      },
      "name": "group-charts-row1"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
