{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "#### Admin Consent URL\n\nUse the link below to onboard a new client tenant. The admin of the client tenant must open this link and grant consent for Beacon.\n\n`{{CONSENT_URL}}`"
      },
      "name": "text-consent-url"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Beacon_Log_CL\n| where LogType == 'sync'\n| summarize arg_max(TimeGenerated, Status, Message, DurationMs) by ClientTenantName, ClientTenantId\n| project TenantName = ClientTenantName, TenantId = ClientTenantId, LastSync = TimeGenerated, Status, Message, Duration = DurationMs\n| order by LastSync desc",
        "size": 3,
        "title": "Synced Tenants",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "LastSync",
              "formatter": 6,
              "formatOptions": {
                "customColumnWidthSetting": "180px"
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "success",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "error",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "pending",
                    "representation": "yellow",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "Duration",
              "formatter": 0,
              "numberFormat": {
                "unit": 23,
                "options": {
                  "style": "decimal",
                  "maximumFractionDigits": 0
                }
              }
            }
          ],
          "sortBy": [
            {
              "itemKey": "LastSync",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "table-synced-tenants"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Beacon_Log_CL\n| where LogType == 'system'\n| project TimeGenerated, Status, Message, ClientTenantName, ClientTenantId\n| order by TimeGenerated desc\n| take 100",
        "size": 3,
        "title": "System Events",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "TimeGenerated",
              "formatter": 6,
              "formatOptions": {
                "customColumnWidthSetting": "180px"
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "success",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "error",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "Message",
              "formatter": 0,
              "formatOptions": {
                "customColumnWidthSetting": "400px"
              }
            }
          ],
          "sortBy": [
            {
              "itemKey": "TimeGenerated",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "table-system-events"
    }
  ],
