{
  "name": "User password reset by admin",
  "description": "{{UserId}} reset the password for {{TargetResources.0.userPrincipalName}}",
  "severity": "Medium",
  "enabled": true,
  "source": "AuditLog",
  "mitre": {
    "tactic": "Persistence",
    "technique": "T1098"
  },
  "conditions": {
    "match": "all",
    "rules": [
      { "field": "Operation", "operator": "Equals", "value": "Reset password (by admin)" },
      { "field": "UserId", "operator": "NotEquals", "value": "{{TargetResources.0.userPrincipalName}}" }
    ]
  },
  "meta": {
    "author": "emildosen",
    "created": "2025-12-26",
    "updated": "2026-03-31"
  }
}
