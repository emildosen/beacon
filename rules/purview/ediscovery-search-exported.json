{
  "name": "eDiscovery search exported",
  "description": "{{UserId}} started export of eDiscovery case '{{CaseName}}'",
  "severity": "Critical",
  "enabled": true,
  "source": "AuditLog",
  "mitre": {
    "tactic": "Collection",
    "technique": "T1213"
  },
  "conditions": {
    "match": "any",
    "rules": [
      { "field": "Operation", "operator": "Equals", "value": "PurviewSearchExportJobSubmitted" },
      { "field": "Operation", "operator": "Equals", "value": "New-ComplianceSearchAction" }
    ]
  },
  "meta": {
    "author": "emildosen",
    "created": "2025-12-26",
    "updated": "2026-03-31"
  }
}
